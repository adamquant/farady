# .gitattributes - Merge strategies for special files on release-pypi branch

# Protect special files from being overwritten during merges
.github/workflows/pypi-release-tests.yml merge=ours
setup.py merge=ours
build_pypi.sh merge=ours
RELEASE_PYPI_NOTES.md merge=ours

# The pyproject.toml file needs special handling - we want to keep our version
# but still allow updates from main for non-Cython dependencies
pyproject.toml merge=union